{
  "info": {
    "_postman_id": "f5c6dc0f-40ab-4b30-9f0c-3dbb8dcfa001",
    "name": "FlyRank Capstone API",
    "description": "Requests for health, Swagger UI, tenant authentication, tenant-scoped widget CRUD, public delivery, submissions and dashboard. See README.md for the complete setup guide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Strong-password-123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "widgetId",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Reports healthy status', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger API docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api-docs/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Swagger UI is available', function () { pm.response.to.have.status(200); });",
                  "pm.test('Swagger UI HTML is returned', function () { pm.expect(pm.response.text()).to.include('swagger-ui'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register tenant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'tenant-' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tenant registered', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('tenantId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Widgets",
      "item": [
        {
          "name": "List widgets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/widgets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create signup widget",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Website lead form\",\n  \"type\": \"signup\",\n  \"settings\": {\n    \"color\": \"blue\",\n    \"buttonText\": \"Send\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/widgets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Widget created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('widgetId', pm.response.json().id);",
                  "pm.test('Embed snippet generated', function () { pm.expect(pm.response.json().embed_snippet).to.include(pm.response.json().id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get widget",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Widget retrieved', function () { pm.response.to.have.status(200); });",
                  "pm.test('Widget has embed snippet', function () { pm.expect(pm.response.json().embed_snippet).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update widget",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated lead form\"\n}"
            },
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Widget updated', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated title is returned', function () { pm.expect(pm.response.json().title).to.eql('Updated lead form'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete widget",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Widget deleted', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Delivery",
      "item": [
        {
          "name": "Get widget script",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/widget.js"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Widget script is served', function () { pm.response.to.have.status(200); });",
                  "pm.test('Widget script is cacheable', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('public'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get public widget config",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              }
            ],
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}/config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public config is available', function () { pm.response.to.have.status(200); });",
                  "pm.test('CORS allows public embedding', function () { pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('*'); });",
                  "pm.test('Config does not expose tenant data', function () { pm.expect(pm.response.json()).to.not.have.property('tenant_id'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit widget lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"widget_id\": \"{{widgetId}}\",\n  \"data\": {\n    \"name\": \"Postman Visitor\",\n    \"email\": \"visitor@example.com\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/submissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Submission is accepted', function () { pm.response.to.have.status(201); });",
                  "pm.test('Submission response has an ID', function () { pm.expect(pm.response.json().id).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List widget submissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}/submissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard submissions are available', function () { pm.response.to.have.status(200); });",
                  "pm.test('Dashboard submissions are an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get widget stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/widgets/{{widgetId}}/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard stats are available', function () { pm.response.to.have.status(200); });",
                  "pm.test('Stats include total submissions', function () { pm.expect(pm.response.json()).to.have.property('total_submissions'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Widgets reject missing token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/widgets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized without token', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Widgets reject invalid payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"type\": \"invalid-type\"\n}"
            },
            "url": "{{baseUrl}}/api/widgets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid payload returns 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Validation details are returned', function () { pm.expect(pm.response.json().details).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submission rejects honeypot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"widget_id\": \"{{widgetId}}\",\n  \"data\": {\n    \"email\": \"bot@example.com\",\n    \"address_line_2\": \"bot filled this field\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/submissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Honeypot submission is rejected', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Submission rejects oversized payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:8080"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"widget_id\": \"{{widgetId}}\",\n  \"data\": {\n    \"content\": \"Replace this text with more than 16kb to test the payload limit.\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/submissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Oversized payload returns 413', function () { pm.expect([400, 413]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
